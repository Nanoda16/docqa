# CampusQA 业务后端环境变量示例（复制为 backend/.env 后修改）
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=campus_qa

# JWT 签名密钥（生产环境请使用至少 32 位高熵随机字符串）
JWT_SECRET_KEY=please-generate-a-strong-random-secret-key
JWT_EXPIRE_MINUTES=1440

# AI 微服务地址及内部鉴权令牌（两端保持一致，留空为本地开发免密模式）
AI_SERVICE_URL=http://127.0.0.1:8003
INTERNAL_API_TOKEN=

# Redis 配置（未启动 Redis 且 REDIS_FALLBACK_TO_FAKE=true 时自动降级到本地 SQLite）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_FALLBACK_TO_FAKE=true
